{
  "_about": "Shared behavior fixtures. tests/test_asp.py runs them through asp.py and tests/logic.test.js runs them through site/logic.js, so the two implementations cannot drift. Minutes are since midnight; days are Mon=0..Sun=6; 2026-10-15 is a Thursday.",
  "max_wait": 45,

  "time_parse": [
    {"in": "7:45", "out": 465},
    {"in": "07:45", "out": 465},
    {"in": "7:45AM", "out": 465},
    {"in": "7:45 am", "out": 465},
    {"in": "8AM", "out": 480},
    {"in": "9", "out": 540},
    {"in": "9pm", "out": 1260},
    {"in": "12AM", "out": 0},
    {"in": "12PM", "out": 720},
    {"in": "12:30PM", "out": 750},
    {"in": "0:00", "out": 0},
    {"in": "13:00", "out": 780},
    {"in": "23:59", "out": 1439},
    {"in": "24:00", "out": null},
    {"in": "25:00", "out": null},
    {"in": "7:60", "out": null},
    {"in": "13PM", "out": null},
    {"in": "0AM", "out": null},
    {"in": "", "out": null},
    {"in": "abc", "out": null}
  ],

  "time_format": [
    {"in": 465, "out": "7:45AM"},
    {"in": 0, "out": "12AM"},
    {"in": 60, "out": "1AM"},
    {"in": 720, "out": "12PM"},
    {"in": 750, "out": "12:30PM"},
    {"in": 780, "out": "1PM"},
    {"in": 1439, "out": "11:59PM"}
  ],

  "date": [
    {"in": "2026-10-15", "valid": true, "weekday": 3},
    {"in": "2026-10-18", "valid": true, "weekday": 6},
    {"in": "2024-02-29", "valid": true, "weekday": 3},
    {"in": "2026-02-29", "valid": false},
    {"in": "2026-13-01", "valid": false},
    {"in": "2026-10-5", "valid": false},
    {"in": "2026-10-15T00:00", "valid": false},
    {"in": "abc", "valid": false},
    {"in": "", "valid": false}
  ],

  "window": [
    {"arrive": 450, "leave": 720, "ok": true},
    {"arrive": 0, "leave": 1439, "ok": true},
    {"arrive": 540, "leave": 550, "ok": true},
    {"arrive": 720, "leave": 540, "ok": false},
    {"arrive": 540, "leave": 540, "ok": false},
    {"arrive": -1, "leave": 100, "ok": false},
    {"arrive": 100, "leave": 1440, "ok": false},
    {"arrive": null, "leave": 100, "ok": false},
    {"arrive": 100.5, "leave": 200, "ok": false}
  ],

  "status": [
    {"name": "clear_no_window_today", "scheds": [[[1, 4], 540, 630]], "date": "2026-10-15", "arrive": 450, "leave": 720, "holidays": {},
     "expect": {"kind": "clear", "swept": false}},
    {"name": "clear_swept_earlier", "scheds": [[[0, 3], 450, 480]], "date": "2026-10-15", "arrive": 540, "leave": 720, "holidays": {},
     "expect": {"kind": "clear", "swept": true}},
    {"name": "blocked_runs_past_leave", "scheds": [[[0, 3], 660, 750]], "date": "2026-10-15", "arrive": 450, "leave": 720, "holidays": {},
     "expect": {"kind": "blocked", "until": 750}},
    {"name": "blocked_when_leave_equals_end", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "arrive": 450, "leave": 630, "holidays": {},
     "expect": {"kind": "blocked", "until": 630}},
    {"name": "blocked_leave_inside_window", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "arrive": 450, "leave": 600, "holidays": {},
     "expect": {"kind": "blocked", "until": 630}},
    {"name": "wait_exact_halfway", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "arrive": 585, "leave": 720, "holidays": {},
     "expect": {"kind": "wait", "at": 585, "start": 540, "end": 630, "wait": 0}},
    {"name": "wait_max_45_minutes", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "arrive": 540, "leave": 720, "holidays": {},
     "expect": {"kind": "wait", "at": 585, "start": 540, "end": 630, "wait": 45}},
    {"name": "opens_wait_46_too_long", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "arrive": 539, "leave": 720, "holidays": {},
     "expect": {"kind": "opens", "free": 630, "since": null}},
    {"name": "opens_after_halfway_competitive", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "arrive": 600, "leave": 720, "holidays": {},
     "expect": {"kind": "opens", "free": 630, "since": 585}},
    {"name": "opens_not_started_far_away", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "arrive": 480, "leave": 720, "holidays": {},
     "expect": {"kind": "opens", "free": 630, "since": null}},
    {"name": "clear_arrive_at_window_end", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "arrive": 630, "leave": 720, "holidays": {},
     "expect": {"kind": "clear", "swept": true}},
    {"name": "holiday_suspends_cleaning", "scheds": [[[0, 3], 660, 750]], "date": "2026-10-15", "arrive": 450, "leave": 720, "holidays": {"2026-10-15": "Test holiday"},
     "expect": {"kind": "clear", "swept": false}},
    {"name": "holiday_key_with_empty_name_still_suspends", "scheds": [[[0, 3], 660, 750]], "date": "2026-10-15", "arrive": 450, "leave": 720, "holidays": {"2026-10-15": ""},
     "expect": {"kind": "clear", "swept": false}},
    {"name": "two_windows_latest_end_blocks", "scheds": [[[3], 480, 510], [[3], 660, 750]], "date": "2026-10-15", "arrive": 450, "leave": 720, "holidays": {},
     "expect": {"kind": "blocked", "until": 750}},
    {"name": "two_windows_opens_at_latest_end", "scheds": [[[3], 480, 510], [[3], 540, 630]], "date": "2026-10-15", "arrive": 470, "leave": 720, "holidays": {},
     "expect": {"kind": "opens", "free": 630, "since": null}},
    {"name": "two_windows_wait_on_the_last_one", "scheds": [[[3], 480, 510], [[3], 540, 630]], "date": "2026-10-15", "arrive": 555, "leave": 720, "holidays": {},
     "expect": {"kind": "wait", "at": 585, "start": 540, "end": 630, "wait": 30}},
    {"name": "wait_only_counts_window_that_ends_last", "scheds": [[[3], 540, 630], [[3], 600, 700]], "date": "2026-10-15", "arrive": 570, "leave": 720, "holidays": {},
     "expect": {"kind": "opens", "free": 700, "since": null}},
    {"name": "sunday_has_no_cleaning", "scheds": [[[0, 1, 2, 3, 4, 5], 450, 480]], "date": "2026-10-18", "arrive": 450, "leave": 720, "holidays": {},
     "expect": {"kind": "clear", "swept": false}},
    {"name": "midnight_window_already_over", "scheds": [[[3], 0, 180]], "date": "2026-10-15", "arrive": 450, "leave": 720, "holidays": {},
     "expect": {"kind": "clear", "swept": true}},
    {"name": "overnight_segment_is_ignored", "scheds": [[[3], 1380, 120]], "date": "2026-10-15", "arrive": 450, "leave": 720, "holidays": {},
     "expect": {"kind": "clear", "swept": false}},
    {"name": "short_stay_10_minutes_clear", "scheds": [[[3], 540, 630]], "date": "2026-10-15", "arrive": 640, "leave": 650, "holidays": {},
     "expect": {"kind": "clear", "swept": true}},
    {"name": "short_stay_10_minutes_blocked", "scheds": [[[3], 540, 630]], "date": "2026-10-15", "arrive": 600, "leave": 610, "holidays": {},
     "expect": {"kind": "blocked", "until": 630}},
    {"name": "all_day_stay_opens", "scheds": [[[3], 540, 630]], "date": "2026-10-15", "arrive": 0, "leave": 1439, "holidays": {},
     "expect": {"kind": "opens", "free": 630, "since": null}},
    {"name": "invalid_window_leave_before_arrive", "scheds": [[[3], 540, 630]], "date": "2026-10-15", "arrive": 720, "leave": 540, "holidays": {},
     "expect": {"error": true}},
    {"name": "invalid_window_zero_length", "scheds": [[[3], 540, 630]], "date": "2026-10-15", "arrive": 540, "leave": 540, "holidays": {},
     "expect": {"error": true}},
    {"name": "invalid_date", "scheds": [[[3], 540, 630]], "date": "2026-02-30", "arrive": 450, "leave": 720, "holidays": {},
     "expect": {"error": true}}
  ],

  "next_cleaning": [
    {"name": "next_is_monday", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "after": 720, "holidays": {},
     "expect": {"offset": 4, "start": 540}},
    {"name": "later_today", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "after": 500, "holidays": {},
     "expect": {"offset": 0, "start": 540}},
    {"name": "after_is_inclusive", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "after": 540, "holidays": {},
     "expect": {"offset": 0, "start": 540}},
    {"name": "one_minute_past_start_skips_today", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "after": 541, "holidays": {},
     "expect": {"offset": 4, "start": 540}},
    {"name": "holiday_is_skipped", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "after": 720, "holidays": {"2026-10-19": "Test holiday"},
     "expect": {"offset": 7, "start": 540}},
    {"name": "holiday_key_with_empty_name_is_skipped", "scheds": [[[0, 3], 540, 630]], "date": "2026-10-15", "after": 720, "holidays": {"2026-10-19": ""},
     "expect": {"offset": 7, "start": 540}},
    {"name": "holiday_today_moves_to_tomorrow", "scheds": [[[3, 4], 540, 630]], "date": "2026-10-15", "after": 0, "holidays": {"2026-10-15": "Test holiday"},
     "expect": {"offset": 1, "start": 540}},
    {"name": "earliest_window_of_the_day", "scheds": [[[3], 480, 510], [[3], 540, 630]], "date": "2026-10-15", "after": 490, "holidays": {},
     "expect": {"offset": 0, "start": 540}},
    {"name": "sunday_only_schedule", "scheds": [[[6], 540, 600]], "date": "2026-10-15", "after": 0, "holidays": {},
     "expect": {"offset": 3, "start": 540}},
    {"name": "no_schedule_at_all", "scheds": [], "date": "2026-10-15", "after": 0, "holidays": {},
     "expect": null},
    {"name": "overnight_segment_ignored", "scheds": [[[3], 1380, 120]], "date": "2026-10-15", "after": 0, "holidays": {},
     "expect": null}
  ]
}
